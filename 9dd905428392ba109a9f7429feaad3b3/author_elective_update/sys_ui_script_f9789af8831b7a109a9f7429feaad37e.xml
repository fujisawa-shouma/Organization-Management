        <script><![CDATA[// Replace "yourFunctionName" with an appropriate function name

(function() {
    try {
        // URL から必要なパラメータを取得
        var url = new GlideURL(window.location.href);
        var table = url.getParam("sysparm_table");
        var view = url.getParam("sysparm_view");

        // 対象テーブル & 対象ビューのみ
        if (table !== "x_1882833_organi_0_jinji_idou") // ←対象テーブルに変更
            return;

        // view 未指定のときは "default" という扱いにしたい場合はここで補正してもOK
        if (!view || view === "") {
            view = "default";
        }

        if (view === "export") { // ←表示したいビュー名
            showListViewInfoMessage("このビューでは一部の列が制限されています。");
        }
    } catch (e) {
        jslog("ListView message script error: " + e);
    }
});

// Define your core UI functions here
function showListViewInfoMessage(msg) {


    var target = document.querySelector(".list_nav_top") ||
        document.querySelector(".navbar-header");

    if (!target)
        return;

    var html =
        '<div class="alert alert-info list-custom-message" style="margin: 8px 0;">' +
        '<span class="icon-info btn-icon"></span> ' +
        msg +
        '</div>';

    target.insertAdjacentHTML("afterend", html);

}]]></script>
