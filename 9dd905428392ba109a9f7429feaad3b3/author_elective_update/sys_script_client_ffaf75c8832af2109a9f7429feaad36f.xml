        <name>関連リスト表示制限</name>
        <order/>
        <script><![CDATA[function onLoad() {

    // 初回表示時の切替
    toggleSections(g_form.getValue('sinsei_shubetu'));

    // 値変更時も即時切替
    g_form.onChange('sinsei_shubetu', function(ctrl, oldVal, newVal) {
        toggleSections(newVal);
    });
}

function toggleSections(val) {
    // ★ セクション見出しを EXACT に書く（全角含む）
    var sectionA = '異動情報明細（一般）';
    var sectionB = '異動情報明細（幹部）';

    if (val == '1') {
        g_form.setSectionDisplay(sectionA, true);
        g_form.setSectionDisplay(sectionB, false);
    } else if (val == '2') {
        g_form.setSectionDisplay(sectionA, false);
        g_form.setSectionDisplay(sectionB, true);
    } else {
        // どちらにも当てはまらない場合は両方非表示
        g_form.setSectionDisplay(sectionA, false);
        g_form.setSectionDisplay(sectionB, false);
    }
}]]></script>
