        <script><![CDATA[if (producer.sinsei_shubetu == '2' && producer.meisai_sakusei == 'ikkatu') {
    var api = new Ikkatusinsei();
    var answer = api.ikkatu(current.sys_id, producer.sinsei_shubetu);

    if (answer != "OK") {
        current.setAbortAction(true);
        gs.setRedirect('/now/nav/ui/classic/params/target/com.glideapp.servicecatalog_cat_item_view.do%3Fv%3D1%26sysparm_id%3Df89a87d48362b6109a9f7429feaad3e5&sinsei_shubetu=' + producer.sinsei_shubetu + '&meisai_sakusei=' + producer.meisai_sakusei);

        if (answer == "添付無し") {
            gs.addErrorMessage('一括申請用のExcelファイルは必須です。少なくとも1件添付してください。');

        } else if (answer == "フォーマット違い") {
            gs.addErrorMessage('Excelファイルのフォーマットが違います。内容を確認して再添付してください。');

        } else if (answer == "データ不足") {
            gs.addErrorMessage('必須データが入力されていません。');

        } else if (answer == "エラー") {
            gs.addErrorMessage('エラー');
        }
    } else {
        current.ikkatu_flg = true;
        current.sinsei_shubetu = producer.sinsei_shubetu;
    }
}]]></script>
