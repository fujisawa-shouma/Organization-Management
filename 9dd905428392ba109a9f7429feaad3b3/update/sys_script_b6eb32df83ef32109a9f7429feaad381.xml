        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    var sinsei = current.sinsei_number;
    var hatureibi = current.hatureibi;
    var name = current.name.u_ukanji_name;
    var number = current.number;
    var oya_meisai = current.sys_id;
    var str;

    if (!gs.nil(name)) {
        str = '[' + hatureibi + ']' + name + '(' + number + ')';
    } else {
        str = '[' + hatureibi + ']()';
    }

    var gr = new GlideRecord('x_1882833_organi_0_meisai');
    gr.addQuery('sinsei_number', sinsei);
    gr.addQuery('oya_meisai', oya_meisai);
    gr.query();

    while (gr.next()) {
        gr.name_kanji = str;
        gr.update();
    }

    if (current.kenmu_number == "新規入力欄") {
        current.kenmu_number = "入力中";
    }



})(current, previous);]]></script>
