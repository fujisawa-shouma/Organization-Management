        <schema_version>1.0.0</schema_version>
        <script><![CDATA[function transform(input) {
	gs.info('サーバー側まできたよ');
	var records = input.records;
	var meisai_num = [];
	var sinsei_num = '';

	var gr = new GlideRecord('x_1882833_organi_0_meisai');
	gr.addQuery('sys_id', 'IN', records);
	gr.query();

	while(gr.next()) {
		var num = gr.getValue('num');
		sinsei_num = gr.getValue('sinsei_number');
		meisai_num.push(num);
	}
	return{
		meisai_num : meisai_num,
		sinsei_num : sinsei_num
	};
}]]></script>
