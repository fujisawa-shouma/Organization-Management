        <server_script><![CDATA[var kenmu = current.kenmu_number;
var shumu_kyuu = current.shumu_kyuu;

if (kenmu == "新規入力欄") {
        gs.addErrorMessage("新規入力欄は削除できません！！");
        current.setAbortAction(true);
}

if (kenmu == "主務" || kenmu == '追加欄') {
    var sinsei = current.sinsei_number;
    var sys_id = current.sys_id;
    var meisaiGr = new GlideRecord('x_1882833_organi_0_meisai');
    meisaiGr.addQuery('sinsei_number', sinsei);
    meisaiGr.addQuery('oya_meisai', sys_id);
    meisaiGr.addQuery();
    meisaiGr.query();
    meisaiGr.deleteMultiple();
    current.deleteRecord();
	current.setAbortAction(true);
}

if (kenmu.startsWith("兼務")) {
    gs.addErrorMessage("兼務行は削除できません！！");
	current.setAbortAction(true);
}

current.deleteRecord();
]]></server_script>
